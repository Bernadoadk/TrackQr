# TrackQr — variables d'environnement (copier en .env, ne jamais committer les vraies valeurs)

# ── Shopify (fournies par `shopify app dev` en local) ──
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.vercel.app
SCOPES=read_products,write_discounts,read_orders
# Facultatif : domaine personnalisé de boutique accepté par l'auth
SHOP_CUSTOM_DOMAIN=

# ── Base de données (PostgreSQL) ──
DATABASE_URL=postgresql://user:password@localhost:5432/tackqr_db

# ── Domaine encodé dans les QR codes (stable, ne pas changer une fois imprimés) ──
# Par défaut SHOPIFY_APP_URL. Ex. https://scan.votremarque.com (CNAME vers l'hébergement de l'app).
SCAN_BASE_URL=

# ── Facturation : true/development = abonnements de test Shopify ──
TEST_MODE=false

# ── Sécurité ──
# Sel des empreintes d'IP (scans anonymes) — une valeur longue et aléatoire.
IP_HASH_PEPPER=
# Secret des liens d'aperçu signés (par défaut SHOPIFY_API_SECRET).
SIGNING_SECRET=
# Protège /api/cron/weekly-report (Vercel envoie "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# ── E-mails (alertes de leads, rapport hebdomadaire) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=TrackQr
SUPPORT_EMAIL=

# ── Images des pages de campagne (Cloudinary) ──
CLOUDINARY_CLOUD_NAME=
# Soit un preset non signé…
CLOUDINARY_UPLOAD_PRESET=
# …soit une clé API signée
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=trackqr
